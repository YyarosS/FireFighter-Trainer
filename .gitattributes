# ===========================================================================
# Git LFS для проекта FireFighter-Trainer (Unity 6 + VR)
# ---------------------------------------------------------------------------
# Крупные бинарные ассеты не хранятся в истории Git напрямую: вместо них
# в репозиторий попадают LFS-указатели, а сами данные лежат на LFS-сервере.
# Синтаксис: filter=lfs diff=lfs merge=lfs -text
#   -text — запрещает Git выполнять CRLF-нормализацию и diff для бинарников.
# ===========================================================================

# ---------------------------------------------------------------------------
# 3D-модели и анимационные данные
# ---------------------------------------------------------------------------
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.mtl   filter=lfs diff=lfs merge=lfs -text
*.dae   filter=lfs diff=lfs merge=lfs -text
*.3ds   filter=lfs diff=lfs merge=lfs -text
*.max   filter=lfs diff=lfs merge=lfs -text
*.ma    filter=lfs diff=lfs merge=lfs -text
*.mb    filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.abc   filter=lfs diff=lfs merge=lfs -text
*.stl   filter=lfs diff=lfs merge=lfs -text
*.ply   filter=lfs diff=lfs merge=lfs -text
*.usd   filter=lfs diff=lfs merge=lfs -text
*.usda  filter=lfs diff=lfs merge=lfs -text
*.usdc  filter=lfs diff=lfs merge=lfs -text
*.usdz  filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Текстуры и изображения (в т.ч. lightmap/cubemap в EXR/HDR)
# ---------------------------------------------------------------------------
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.tiff  filter=lfs diff=lfs merge=lfs -text
*.bmp   filter=lfs diff=lfs merge=lfs -text
*.gif   filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.psb   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.dds   filter=lfs diff=lfs merge=lfs -text
*.ktx   filter=lfs diff=lfs merge=lfs -text
*.ktx2  filter=lfs diff=lfs merge=lfs -text
*.pvr   filter=lfs diff=lfs merge=lfs -text
*.webp  filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Сцены, префабы-«тяжёлые» данные и baked-данные Unity
# (*.unity — YAML, но сцены в LFS по требованию: они разрастаются и
#  конфликтуют при merge; *.asset/*.mat/*.prefab остаются обычным текстом)
# ---------------------------------------------------------------------------
*.unity        filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
*.lightmap     filter=lfs diff=lfs merge=lfs -text
*.cubemap      filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Аудио
# ---------------------------------------------------------------------------
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.oga   filter=lfs diff=lfs merge=lfs -text
*.aif   filter=lfs diff=lfs merge=lfs -text
*.aiff  filter=lfs diff=lfs merge=lfs -text
*.flac  filter=lfs diff=lfs merge=lfs -text
*.m4a   filter=lfs diff=lfs merge=lfs -text
*.wma   filter=lfs diff=lfs merge=lfs -text
*.xm    filter=lfs diff=lfs merge=lfs -text
*.it    filter=lfs diff=lfs merge=lfs -text
*.mod   filter=lfs diff=lfs merge=lfs -text
*.s3m   filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Видео (записи тренировок, обучающие ролики, референсы)
# ---------------------------------------------------------------------------
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.m4v   filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text
*.avi   filter=lfs diff=lfs merge=lfs -text
*.mkv   filter=lfs diff=lfs merge=lfs -text
*.webm  filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Шрифты
# ---------------------------------------------------------------------------
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
*.ttc   filter=lfs diff=lfs merge=lfs -text
*.woff  filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Прочие бинарные ресурсы: архивы, БД, PDF, табличные данные
# ---------------------------------------------------------------------------
*.zip   filter=lfs diff=lfs merge=lfs -text
*.7z    filter=lfs diff=lfs merge=lfs -text
*.rar   filter=lfs diff=lfs merge=lfs -text
*.gz    filter=lfs diff=lfs merge=lfs -text
*.sqlite filter=lfs diff=lfs merge=lfs -text
*.sqlite3 filter=lfs diff=lfs merge=lfs -text
*.db    filter=lfs diff=lfs merge=lfs -text
*.pdf   filter=lfs diff=lfs merge=lfs -text
*.docx  filter=lfs diff=lfs merge=lfs -text
*.xlsx  filter=lfs diff=lfs merge=lfs -text
*.pptx  filter=lfs diff=lfs merge=lfs -text
*.csv   filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Скрипты, шейдеры, конфиги — обычный текст, различия нужны в истории.
# Явно фиксируем LF, чтобы проект корректно собирался на любой ОС.
# ---------------------------------------------------------------------------
*.cs      text eol=lf
*.shader  text eol=lf
*.hlsl    text eol=lf
*.cginc   text eol=lf
*.shadergraph text eol=lf
*.json    text eol=lf
*.asmdef  text eol=lf
*.asmref  text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.meta    text eol=lf
*.asset   text eol=lf
*.mat     text eol=lf
*.prefab  text eol=lf
*.anim    text eol=lf
*.controller text eol=lf

# Бинарники Windows (плагины редактора, DLL) — не пытаться диффить
*.dll   binary
*.so    binary
*.dylib binary